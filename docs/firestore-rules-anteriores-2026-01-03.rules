// Regras do Firestore que estavam no ar até 08/11/2026 (ruleset f4e03245, de 03/01/2026).
// Guardadas para poder voltar atrás: npx firebase deploy --only firestore:rules com este conteúdo.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regra específica para a sua coleção de usuários
    match /usuarios/{userId} {
      allow read: if true; // Permite que o ranking seja lido por todos
      allow write: if request.auth != null && request.auth.uid == userId; // Só o dono grava o próprio recorde
    }
  }
}
